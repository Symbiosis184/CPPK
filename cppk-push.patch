+let tmFilter = "", srcFilter = "";
+
+function esc(s){ return String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
+
+function norm(s){
+  const tr = {'а':'a','б':'b','в':'v','г':'g','д':'d','е':'e','ё':'e','ж':'zh','з':'z','и':'i','й':'y','к':'k','л':'l','м':'m','н':'n','о':'o','п':'p','р':'r','с':'s','т':'t','у':'u','ф':'f','х':'h','ц':'ts','ч':'ch','ш':'sh','щ':'sch','ъ':'','ы':'y','ь':'','э':'e','ю':'yu','я':'ya'};
+  return s.toLowerCase().split('').map(c=>tr[c]!==undefined?tr[c]:c).join('');
+}
+const lat2cyr = {'zh':'ж','sch':'щ','yu':'ю','ya':'я','kh':'х','a':'а','b':'б','v':'в','g':'г','d':'д','e':'е','z':'з','i':'и','y':'ы','k':'к','l':'л','m':'м','n':'н','o':'о','p':'п','r':'р','s':'с','t':'т','u':'у','f':'ф','h':'х','c':'ц','ch':'ч','sh':'ш','x':'х','j':'й','w':'ш'};
+function revTr(q){
+  let out='', i=0;
+  while(i<q.length){
+    let m=null;
+    for(const L of [3,2,1]){ const ch=q.slice(i,i+L); if(lat2cyr[ch]!==undefined){ m=[ch,L]; break; } }
+    if(m){ out+=lat2cyr[m[0]]; i+=m[1]; } else { out+=q[i]; i++; }
+  }
+  return out;
+}
+function hayOf(t){
+  const keys=["model","vendor","tm_model","connection","ip_scheme","ip","mask","gateway","dns","server","com_port","auth","firmware","notes","number","city","address","sim","ports_out","install_date"];
+  let a = keys.map(k=>t[k]||"").join(" ").toLowerCase();
+  if(t.vlan) a += " vlan " + t.vlan;
+  a += " " + (t.tags||[]).join(" ") + " " + (t.setup_steps||[]).join(" ");
+  return a;
+}
+const qw2cyr = {'q':'й','w':'ц','e':'у','r':'к','t':'е','y':'н','u':'г','i':'ш','o':'щ','p':'з','[':'х',']':'ъ','\\':'ё','a':'ф','s':'ы','d':'в','f':'а','g':'п','h':'р','j':'о','k':'л','l':'д',';':'ж',"'":'э','z':'я','x':'ч','c':'с','v':'м','b':'и','n':'т','m':'ь',',':'б','.':'ю'};
+function qwTr(q){ return q.split('').map(c=>qw2cyr[c]!==undefined?qw2cyr[c]:c).join(''); }
+function matchWord(hayLowered, w){
+  const cands = new Set([w, norm(w), norm(qwTr(w))]);
+  if(/^[\x00-\x7f]+$/.test(w)){ const cyr = revTr(w); cands.add(norm(cyr)); cands.add(norm(qwTr(cyr))); }
+  return [...cands].some(c => hayLowered.includes(c));
+}
+
+function kvRow(label, val){ return `<tr><td>${label}</td><td>${val}</td></tr>`; }
+
+function card(t){
+  const isObj = !!t.object;
+  const rows = [];
+  if(isObj){
+    rows.push(kvRow("№ билетомата", `<code>${esc(t.number)}</code>`));
+    if(t.city || t.address) rows.push(kvRow("Адрес", `${esc(t.city||"")}${t.address ? " — " + esc(t.address) : ""}`));
+  }
+  if(t.ip) rows.push(kvRow("IP-адресация", `<code>${esc(t.ip)}</code> (${esc(t.ip_scheme||"—")})`));
+  if(t.mask || t.gateway) rows.push(kvRow("Маска / Шлюз", `<code>${esc(t.mask)}</code> / <code>${esc(t.gateway)}</code>`));
+  if(t.dns) rows.push(kvRow("DNS", `<code>${esc(t.dns)}</code>`));
+  if(t.vlan) rows.push(kvRow("VLAN", `<code>${esc(t.vlan)}</code>`));
+  if(t.server || t.ports_out) rows.push(kvRow("Серверы / порты", esc(t.server)+(t.ports_out?"<br>"+esc(t.ports_out):"")));
+  if(t.connection) rows.push(kvRow("Интерфейс билетомата", esc(t.connection)));
+  if(t.sim) rows.push(kvRow("SIM / APN", esc(t.sim)));
+  if(t.auth) rows.push(kvRow("Аутентификация", esc(t.auth)));
+  if(t.firmware) rows.push(kvRow("Прошивка", esc(t.firmware)));
+  if(t.install_date) rows.push(kvRow("Дата установки", esc(t.install_date)));
+
+  const badges = [
+    isObj ? `<span class="badge b-num">#${esc(t.number)}</span>` : "",
+    `<span class="badge b-${(t.ticket_machine||'').toLowerCase()}">${esc(t.ticket_machine||"?")}${t.tm_model?" · "+esc(t.tm_model):""}</span>`,
+    t.vendor ? `<span class="badge b-vendor">${esc(t.vendor)}</span>` : "",
+    t.ip_scheme ? `<span class="badge b-scheme">${esc(t.ip_scheme)}</span>` : "",
+  ].join("");
+
+  const steps = (t.setup_steps && t.setup_steps.length)
+    ? `<details open><summary>Порядок настройки</summary><ol class="steps">${t.setup_steps.map(s=>`<li>${esc(s)}</li>`).join("")}</ol></details>` : "";
+  const note = t.notes ? `<div class="note">💡 ${esc(t.notes)}</div>` : "";
+  const title = isObj ? esc(t.model || "Объект") : esc(t.model);
+  return `<div class="card${isObj?' obj':''}">
+    <button class="copy" onclick="copyCard(this)">📋 Копировать</button>
+    <h2>${title}</h2>
+    ${isObj && (t.city||t.address) ? `<div class="loc">📍 <b>${esc(t.city||"")}</b>${t.address?" · "+esc(t.address):""}</div>`:""}
+    <div class="badges">${badges}</div>
+    <table class="kv">${rows.join("")}</table>
+    ${steps}${note}
+  </div>`;
+}
+
+function render(){
+  const qRaw = document.getElementById('q').value.trim();
+  const q = norm(qRaw);
+  const city = document.getElementById('city').value;
+  const sc = document.getElementById('scheme').value;
+  const words = q.split(/\s+/).filter(Boolean);
+  const res = DATA.filter(t=>{
+    if(srcFilter==="obj" && !t.object) return false;
+    if(srcFilter==="ref" && t.object) return false;
+    if(tmFilter && (t.ticket_machine||"").toUpperCase()!==tmFilter) return false;
+    if(city && norm(t.city||"")!==norm(city)) return false;
+    if(sc && !(t.ip_scheme||"").includes(sc)) return false;
+    if(words.length){
+      const hay = hayOf(t);
+      return words.every(w=>matchWord(hay, w));
+    }
+    return true;
+  });
+  const objs = res.filter(r=>r.object).length;
+  document.getElementById('count').textContent =
+    `Найдено: ${res.length} (объектов из файла: ${objs}) · всего в базе: ${DATA.length}`;
+  document.getElementById('results').innerHTML = res.length ? res.map(card).join("")
+    : '<div class="empty">Ничего не найдено. Попробуйте другой запрос или загрузите XLS.</div>';
+}
+
+function fillCities(){
+  const sel = document.getElementById('city');
+  const cur = sel.value;
+  sel.innerHTML = '<option value="">Все города</option>' +
+    [...new Set(DATA.filter(t=>t.city).map(t=>t.city))].sort()
+      .map(c=>`<option${c===cur?' selected':''}>${esc(c)}</option>`).join("");
+}
+
+function copyCard(btn){
+  const c = btn.closest('.card');
+  const txt = c.querySelector('h2').textContent + "\n" +
+    [...c.querySelectorAll('table.kv tr')].map(r=>r.children[0].textContent+": "+r.children[1].innerText).join("\n");
+  navigator.clipboard.writeText(txt).then(()=>{ btn.textContent="✅ Скопировано"; setTimeout(()=>btn.textContent="📋 Копировать",1500); });
+}
+
+// ---------- загрузка файла ----------
+async function doUpload(f){
+  const st = document.getElementById('ustatus');
+  if(!/\.(xls|xlsx|xlsm)$/i.test(f.name)){ st.className='ustatus err'; st.textContent='Нужен файл .xls или .xlsx'; return; }
+  st.className='ustatus'; st.textContent='⏳ Загружаю '+f.name+' …';
+  const fd = new FormData(); fd.append('file', f);
+  try{
+    const r = await fetch('/api/upload',{method:'POST',body:fd});
+    const j = await r.json();
+    if(!j.ok){ st.className='ustatus err'; st.textContent='❌ '+j.error; return; }
+    DATA = REF.concat(j.cards || []);
+    fillCities(); render();
+    document.getElementById('clrBtn').style.display='';
+    st.className='ustatus ok';
+    st.textContent=`✅ Импортировано объектов: ${j.imported} (листы: ${j.sheets.map(s=>s.name+" — "+s.rows).join(", ")}) · городов: ${j.cities.length}`;
+  }catch(e){ st.className='ustatus err'; st.textContent='❌ Ошибка сети: '+e; }
+}
+async function clearBase(){
+  if(!confirm('Удалить загруженную объектную базу с сервера?')) return;
+  await fetch('/api/upload',{method:'DELETE'});
+  DATA = REF.slice(); fillCities(); render();
+  document.getElementById('clrBtn').style.display='none';
+  const st=document.getElementById('ustatus'); st.className='ustatus'; st.textContent='База очищена.';
+}
+document.getElementById('file').addEventListener('change',e=>{ if(e.target.files[0]) doUpload(e.target.files[0]); e.target.value=''; });
+const up = document.getElementById('uploader');
+['dragover','dragenter'].forEach(ev=>up.addEventListener(ev,e=>{e.preventDefault(); up.classList.add('drag');}));
+['dragleave','drop'].forEach(ev=>up.addEventListener(ev,e=>{e.preventDefault(); up.classList.remove('drag');}));
+up.addEventListener('drop',e=>{ if(e.dataTransfer.files[0]) doUpload(e.dataTransfer.files[0]); });
+
+// ---------- фильтры ----------
+document.getElementById('q').addEventListener('input', render);
+document.getElementById('city').addEventListener('change', render);
+document.getElementById('scheme').addEventListener('change', render);
+document.querySelectorAll('.chip[data-src]').forEach(ch=>ch.addEventListener('click',()=>{
+  document.querySelectorAll('.chip[data-src]').forEach(c=>c.classList.remove('active'));
+  ch.classList.add('active'); srcFilter=ch.dataset.src; render();
+}));
+document.querySelectorAll('.chip[data-tm]').forEach(ch=>ch.addEventListener('click',()=>{
+  document.querySelectorAll('.chip[data-tm]').forEach(c=>c.classList.remove('active'));
+  ch.classList.add('active'); tmFilter=ch.dataset.tm; render();
+}));
+
+if(DATA.some(t=>t.object)){ document.getElementById('clrBtn').style.display=''; }
+fillCities();
+render();
+</script>
+</body>
+</html>
