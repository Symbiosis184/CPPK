+# -*- coding: utf-8 -*-
+"""База знаний сетевых настроек банковских терминалов под билетоматы BPA / APB.
+
+Данные хранятся в структурированном виде; при необходимости легко расширяются
+новыми моделями терминалов и типами билетоматов.
+"""
+
+TERMINALS = [
+    # ------------------------------------------------------------------ BPA ---
+    {
+        "id": "bpa-infinal-t56px",
+        "model": "InFinal T56px",
+        "vendor": "INPAS",
+        "ticket_machine": "BPA",
+        "tm_model": "BPA-М (турникетный комплекс)",
+        "connection": "RS-232 через COM-порт + Ethernet (основная сеть)",
+        "ip_scheme": "static",
+        "ip": "10.120.44.{N}",
+        "mask": "255.255.255.192",
+        "gateway": "10.120.44.1",
+        "dns": "10.120.0.10, 10.120.0.11",
+        "vlan": "440",
+        "server": "pos.sberbank.ru:443 (VPOS), bpa-gw.vtb-local:8443 (шлюз BPA)",
+        "com_port": "COM2, 115200 8N1",
+        "ports_out": "исходящие TCP 443, 8443, 7001",
+        "auth": "mTLS: сертификат ЭЦП терминала в хранилище СКНД",
+        "firmware": "T56px v4.2.17+ (для BPA обязателен патч TM-протокола 2.3)",
+        "setup_steps": [
+            "Войти в сервисное меню: F1 -> пароль 8888 (сменить после настройки!)",
+            "Сеть -> TCP/IP -> выбрать 'Статический IP', внести адрес из талона билета",
